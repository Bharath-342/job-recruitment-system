# ==========================================
# Job & Recruitment Management System (ATS)
# Environment Configuration Template
# ==========================================

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/job_recruitment_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Server Port
SERVER_PORT=8080

# JWT Security (Base64-encoded secret key with min 256 bits)
JWT_SECRET=c2VjdXJlSldUU2VjcmV0S2V5Rm9ySm9iUmVjcnVpdG1lbnRTeXN0ZW0yMDI0VmVyeUxvbmdLZXk=
JWT_EXPIRATION=86400000

# File Upload Directory
UPLOAD_DIR=./uploads

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API URL (Used by React/Vite)
VITE_API_URL=http://localhost:8080/api
